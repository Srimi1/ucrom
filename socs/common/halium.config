# ucrom halium flavor: what systemd + the Halium Android container + the
# libhybris/binder bridges need from a downstream (vendor) Android kernel.
#
# systemd
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_SECCOMP=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# Halium container (LXC)
CONFIG_SYSVIPC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_BLK_DEV_LOOP=y
# Dynamic ("super") partitions: vendor/odm are dm-linear targets
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
# Normal Linux networking for non-root users (Android restricts sockets)
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# bluebinder bridges the Android Bluetooth HAL into BlueZ through VHCI
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HCIVHCI=y
# UPower / fwupd / NetworkManager friendliness
CONFIG_RTC_CLASS=y
CONFIG_TUN=y
